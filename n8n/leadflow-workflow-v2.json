    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crm-events",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000020",
      "name": "CRM events in",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -880,
        400
      ],
      "notes": "Ei URL ta protyek client er Settings page e 'n8n webhook URL' e boshabe."
    },
    {
      "parameters": {
        "jsCode": "// CRM duirokom event pathay:\n//   type = \"meta_event\"    \u2192 kacha Meta payload\n//   type = \"rule_matched\"  \u2192 keyword rule match hoyeche\nconst e = $input.first().json.body ?? $input.first().json;\n\nreturn [{\n  json: {\n    type:      e.type ?? \"unknown\",\n    tag:       e.tag ?? null,          // rule er n8n_tag\n    orgSlug:   e.org_slug ?? null,     // KON CLIENT \u2014 eta chara kichu pathano jabe na\n    orgId:     e.org_id ?? null,\n    ruleName:  e.rule_name ?? null,\n    channel:   e.channel ?? null,\n    leadId:    e.lead?.id ?? null,\n    leadName:  e.lead?.name ?? null,\n    phone:     e.lead?.channel_uid ?? e.lead?.phone ?? null,\n    message:   e.message ?? null,\n    raw: e,\n  }\n}];"
      },
      "id": "b2000000-0000-4000-8000-000000000021",
      "name": "Read the event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -660,
        400
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.orgSlug }}",
                    "rightValue": "client-one",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "client-one"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.orgSlug }}",
                    "rightValue": "client-two",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "client-two"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "everyone else"
        }
      },
      "id": "b2000000-0000-4000-8000-000000000022",
      "name": "Which client?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        -440,
        400
      ],
      "notes": "NOTUN CLIENT ADD KORAR JAYGA: ekhane ekta rule baraye tar slug boshao."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.tag }}",
                    "rightValue": "greeting_payment",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "payment link"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.tag }}",
                    "rightValue": "price_list",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "price list"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "anything else"
        }
      },
      "id": "b2000000-0000-4000-8000-000000000023",
      "name": "What did they ask for?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        -220,
        300
      ],
      "notes": "CRM er Reply Rules page e je tag likhbi, seta ekhane branch hobe."
    },
    {
      "parameters": {
        "jsCode": "// Client-one er payment flow.\n// Onno client er jonno ei node ta copy kore bodle nao.\nconst d = $input.first().json;\n\nconst amount = 500;\nconst link = `https://pay.example.com/checkout?ref=${d.leadId}&amt=${amount}`;\n\nreturn [{\n  json: {\n    orgSlug: d.orgSlug,\n    phone: d.phone,\n    text: `Assalamu alaikum ${d.leadName || ''}!\\n\\n`\n        + `Amader service charge: ${amount} taka.\\n`\n        + `Payment korte ei link e jan:\\n${link}\\n\\n`\n        + `bKash: 01XXXXXXXXX (Send Money)\\n`\n        + `Payment er por TrxID ta ekhane pathan.`,\n  }\n}];"
      },
      "id": "b2000000-0000-4000-8000-000000000024",
      "name": "Build the payment message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set config').first().json.crmUrl }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-crm-secret",
              "value": "={{ $('Set config').first().json.crmSecret }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"action\":\"send_message\",\"org_slug\":\"{{ $json.orgSlug }}\",\"phone\":\"{{ $json.phone }}\",\"text\":\"{{ $json.text }}\"}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b2000000-0000-4000-8000-000000000025",
      "name": "Send it back",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Kono tag match na korle \u2014 sudhu log kore rakhi.\n// Ekhane Slack notify, Google Sheet e likha, ja khushi korte parish.\nconsole.log('Unhandled event:', $input.first().json.type, $input.first().json.tag);\nreturn $input.all();"
      },
      "id": "b2000000-0000-4000-8000-000000000026",
      "name": "Mark the lead hot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
