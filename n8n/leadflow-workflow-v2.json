        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"action\":\"send_template\",\"org_slug\":\"{{ $('Client by client').item.json.slug }}\",\"phone\":\"{{ $json.phone }}\",\"template\":\"{{ $json.template }}\",\"language\":\"{{ $json.language }}\",\"variables\":[\"{{ $json.name }}\"]}",
