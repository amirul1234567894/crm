# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...     # secret — server only, kokhono NEXT_PUBLIC na

# ---- Encryption (JORURI) ----
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Hariye gele sob Meta token decrypt kora jabe na. BACKUP RAKH.
SECRETS_KEY=

# ---- n8n / cron ----
N8N_SHARED_SECRET=          # n8n → CRM (per-org secret o support kore, Settings dekh)
CRON_SECRET=                # /api/cron endpoint er jonno (n8n schedule / Vercel cron)

# ---- App ----
NEXT_PUBLIC_APP_URL=https://crm.yourdomain.com

# ---- Rate limiting (optional — Upstash, free tier) ----
# Na dile built-in in-memory limiter cholbe (single region e enough)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NOTE: META_ACCESS_TOKEN / WA_PHONE_NUMBER_ID / META_VERIFY_TOKEN
# ar lagbe na — protyek client er credentials database e (encrypted).

# ---- Monitoring (H-7 fix -- optional until you have a Sentry account) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
